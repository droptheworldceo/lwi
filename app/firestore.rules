rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.nickname is string;
      allow update: if isOwner(uid);

      match /checkins/{date} {
        allow read, write: if isOwner(uid);
      }
    }

    match /channels/{channelId} {
      allow read: if true;
      allow create, update: if isVerified();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.kind in ['experience', 'evidence'];
      allow update: if isVerified() && (
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['empathyCount', 'commentCount'])
      );
      allow delete: if isVerified() && resource.data.authorUid == request.auth.uid;

      match /reactions/{uid} {
        allow read: if true;
        allow create, delete: if isOwner(uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isVerified() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isVerified() && resource.data.authorUid == request.auth.uid;
      }
    }

    // 신고: 신고자 본인만 자신이 낸 신고를 만들고 읽을 수 있다.
    // 검토(모더레이션)는 별도 운영자 화면이 생기기 전까지 콘솔에서 수동 확인.
    match /reports/{reportId} {
      allow create: if isVerified() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
    }
  }
}
